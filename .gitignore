# Ignore LaTeX intermediate files
*.aux
*.fls
*.log
*.out
*.pdf
*.fdb_latexmk
*.synctex.gz

# Ignore backups and copies
*.tex.backup
*copy.*

# Ignore all contents of /applied directory (company-specific applications)
/applied/*
# But keep the directory itself
!/applied/.gitkeep

# Ignore all resume variants except resume.tex
/resumes/*
!/resumes/sample/
/resumes/sample/*
!/resumes/sample/resume.tex

# Ignore personal information config files (keep templates only)
/config/personal-info.tex
/config/PERSONAL_INFO.md

# Ignore personal signature (keep sample only)
/signature.png

# ============================================
# Monorepo - Web Application
# ============================================

# Environment variables
.env
.env.local
.env.*.local

# Frontend (Node.js / Vite)
node_modules/
dist/
.vite/
*.local
.cache/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Backend (Python / Poetry)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
.poetry/
poetry.lock
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Docker
docker-compose.override.yml
*.env.docker

# IDE
.vscode/
.idea/
*.swp
*.swo
*~